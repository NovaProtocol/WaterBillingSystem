# =============================================================================
# WaterBillingSystem — Environment Variables
# =============================================================================
# Copy this file to .env in the project root and fill in all values.
# Every variable is REQUIRED. Missing vars will cause containers to fail.
# =============================================================================

# ── Deployment ──────────────────────────────────────────────────────────────
DEPLOYMENT_TYPE=PRODUCTION
# Set DEBUG=true to bypass receipt verification in customer portal
DEBUG=false

# ── Secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))") ──
SECRET_KEY=
INTERNAL_API_KEY=

# ── Database ────────────────────────────────────────────────────────────────
DB_ENGINE=mysql+pymysql
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=BillServerDB
DB_USERNAME=root
DB_PASS=

# ── API Endpoints (internal Docker DNS) ─────────────────────────────────────
API_BASE_URL=http://api:8008

# ── NFC Security (64 hex chars) ─────────────────────────────────────────────
NFC_PWD_SECRET=

# ── Xendit Payment Gateway ──────────────────────────────────────────────────
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=

# ── Flask-Cache ─────────────────────────────────────────────────────────────
CACHE_TYPE=SimpleCache

# ── Python Free-threading ───────────────────────────────────────────────────

# ── phpMyAdmin ──────────────────────────────────────────────────────────────
# When PMA_CONFIG_BASE64 is set, it REPLACES the generated config entirely
# (host/port/auth are set inside it). Encode with: base64 -w0 config.inc.php
PMA_CONFIG_
# ^ base64 of: server1 = admin (cookie auth), server2 = guest (config auth,
#   instant login, password + only_db come from getenv)
# The guest MySQL account itself is provisioned automatically by the API
# container at startup (shared/services/guest_seeder.py) when the password is set.
GUEST_DB_PASSWORD=
PMA_HOST=mysql-db
PMA_PORT=3306
PMA_ARBITRARY=0
UPLOAD_LIMIT=50M

# ── Debug Container ─────────────────────────────────────────────────────────
