# Enable DEBUG mode (superuser-only debug dashboard in staff portal)
# DEBUG=true

# ── Required ─────────────────────────────────────────────

# Used by Flask to sign cookies and other security related needs
# CHANGE THIS — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-hex-char-string

# Used by the NFC tag generator to generate a unique 256-bit password for each NFC tag
# CHANGE THIS — generate with: python -c "import secrets; print(secrets.token_hex(32))"
NFC_PWD_SECRET=change-me-to-a-random-64-hex-char-string

# MySQL Database
DB_ENGINE=mysql+pymysql
DB_NAME=BillServerDB
DB_HOST=db
DB_PORT=3306
DB_USERNAME=root
DB_PASS=change-me

# ── Optional ──────────────────────────────────────────────

# Run mode: DEBUG or PRODUCTION (default: PRODUCTION)
# DEPLOYMENT_TYPE=PRODUCTION

# Serve under a URL prefix path (e.g. /water-billing-system).
# Two modes:
#   1. Path (recommended): set to your prefix path directly.
#      No nginx header needed — app auto-prefixes all URLs.
#        REVERSE_PROXY_PREFIX=/water-billing-system
#
#   2. Boolean: set to any truthy value to enable ProxyFix.
#      Requires nginx to send X-Forwarded-Prefix header.
#        REVERSE_PROXY_PREFIX=true
#
# Leave unset/empty to serve at root (default).
# REVERSE_PROXY_PREFIX=/water-billing-system

# Restrict session cookies to HTTPS only (default: true).
# Set to "false" if serving over HTTP in development.
# SESSION_COOKIE_SECURE=false

# SSL certificates for development HTTPS (comment out for HTTP-only)
# SSL_CERTFILE=certificates/dev-cert.pem
# SSL_KEYFILE=certificates/dev-key.pem

# Xendit Payment Gateway — secret API key from https://dashboard.xendit.co/settings/developers#api-keys
# XENDIT_API_KEY=xnd_development_...
# XENDIT_WEBHOOK_TOKEN=your-webhook-verification-token
