# =============================================================================
# WaterBillingSystem: Environment Variables
# =============================================================================
# Documentation only: there is NO .env file; values come from compose
# interpolation (${VAR:?} in compose.yaml) or your shell. This file
# documents every variable; compose fails fast if a required var is missing.
# Every variable is REQUIRED unless a default is noted.
# =============================================================================

# ── Deployment ──────────────────────────────────────────────────────────────
DEPLOYMENT_TYPE=PRODUCTION
# Set DEBUG=true to bypass receipt verification in customer portal
DEBUG=false

# ── Secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))") ──
# SECRET_KEY signs portal JWTs (PyJWT HS256 ISS=wbs AUD=waterbillingsystem, >=32 chars,
# billing_session 12h / staff+dev session 8h); HS256 reuses SECRET_KEY, no JWT_SECRET needed.
SECRET_KEY=
INTERNAL_API_KEY=

# ── Database ────────────────────────────────────────────────────────────────
DB_ENGINE=mysql+pymysql
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=BillServerDB
DB_USERNAME=root
DB_PASS=

# ── API Endpoints (internal Docker DNS) ─────────────────────────────────────
# Public traffic enters via Caddy handle /api/* → api:8008 (HTTP).
# Internal container-to-container traffic prefers gRPC on api:50051.
API_BASE_URL=http://api:8008
API_INTERNAL_URL=http://api:8008
API_GRPC_ADDR=api:50051

# ── NFC Security (64 hex chars) ─────────────────────────────────────────────
NFC_PWD_SECRET=

# ── Xendit Payment Gateway ──────────────────────────────────────────────────
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=

# ── Background Worker ───────────────────────────────────────────────────────
# How many background jobs the worker runs concurrently (default 8)
WORKER_JOB_CONCURRENCY=8

# ── Shared runtime (read strictly by shared/config.py: all REQUIRED) ───────
# SESSION_COOKIE_SECURE=true enables secure cookies (use false on http dev)
SESSION_COOKIE_SECURE=true
# Reverse-proxy prefix; usually empty (empty IS the valid value, the only
# variable allowed to be blank)
REVERSE_PROXY_PREFIX=
# Static/template dirs; leave as the container defaults below
SHARED_STATIC_DIR=/app/shared/static
SHARED_TEMPLATES_DIR=/app/shared/templates

# ── phpMyAdmin ──────────────────────────────────────────────────────────────
# When PMA_CONFIG_BASE64 is set, it REPLACES the generated config entirely
# (host/port/auth are set inside it). Encode with: base64 -w0 config.inc.php
PMA_CONFIG_
# ^ base64 of: server1 = admin (cookie auth), server2 = guest (config auth,
#   instant login, password + only_db come from getenv)
# The guest MySQL account is provisioned automatically by the API container at
# startup (shared/services/guest_seeder.py). REQUIRED: compose fails without it.
GUEST_DB_PASSWORD=
PMA_HOST=mysql-db
PMA_PORT=3306
PMA_ARBITRARY=0
UPLOAD_LIMIT=50M

# ── Debug Container ─────────────────────────────────────────────────────────
