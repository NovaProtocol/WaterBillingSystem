# True for development, False for production
DEBUG=True

# Flask ENV
FLASK_APP=run.py
FLASK_DEBUG=1

# Used by Flask to sign cookies and other security related needs
# CHANGE THIS — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-hex-char-string

# Used by the NFC tag generator to generate a unique 256-bit password for each NFC tag
# CHANGE THIS — generate with: python -c "import secrets; print(secrets.token_hex(32))"
NFC_PWD_SECRET=change-me-to-a-random-64-hex-char-string

# MySQL Database (Docker: BillServerDB container)
DB_ENGINE=mysql+pymysql
DB_NAME=BillServerDB
DB_HOST=db
DB_PORT=3306
DB_USERNAME=root
DB_PASS=change-me

# ── Optional ──────────────────────────────────────────────

# Reverse Proxy Prefix — serve under a URL path (e.g. /water-billing-system).
#
# Two modes:
#   1. Path (recommended): set to your prefix path directly.
#      No nginx header needed — app auto-prefixes all URLs.
#        REVERSE_PROXY_PREFIX=/water-billing-system
#
#   2. Boolean: set to any non-empty value to enable ProxyFix.
#      Requires nginx to send X-Forwarded-Prefix header.
#      See deploy/nginx-billserver.conf for details.
#        REVERSE_PROXY_PREFIX=true
#
# Leave unset/empty to serve at root (default).
# REVERSE_PROXY_PREFIX=/water-billing-system

# SSL (comment out for HTTP-only)
# SSL_CERTFILE=certificates/dev-cert.pem
# SSL_KEYFILE=certificates/dev-key.pem
