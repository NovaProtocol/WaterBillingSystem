# =============================================================================
# WaterBillingSystem — Environment Variables
# =============================================================================
# Copy this file to .env in the project root and fill in all values.
# Every variable is REQUIRED. Missing vars will cause containers to fail.
# =============================================================================

# ── Deployment ──────────────────────────────────────────────────────────────
DEPLOYMENT_TYPE=PRODUCTION
# Set DEBUG=true to bypass receipt verification in customer portal
DEBUG=false

# ── Secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))") ──
SECRET_KEY=
INTERNAL_API_KEY=

# ── Database ────────────────────────────────────────────────────────────────
DB_ENGINE=mysql+pymysql
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=BillServerDB
DB_USERNAME=root
DB_PASS=

# ── API Endpoints (internal Docker DNS) ─────────────────────────────────────
API_BASE_URL=http://api:8008

# ── NFC Security (64 hex chars) ─────────────────────────────────────────────
NFC_PWD_SECRET=

# ── Xendit Payment Gateway ──────────────────────────────────────────────────
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=

# ── Flask-Cache ─────────────────────────────────────────────────────────────
CACHE_TYPE=SimpleCache

# ── Python Free-threading ───────────────────────────────────────────────────
PYTHON_GIL=0

# ── Caddy Gateway Ports ────────────────────────────────────────────────────
# Public port serves landing page, customer portal, and webhooks.
# Private port serves staff portal, developer portal, and API (mTLS required).
# Set both to the same value (e.g. 8001) for local dev without mTLS.
CADDY_PORT_PUBLIC=8001
CADDY_PORT_PRIVATE=8002

# ── phpMyAdmin ──────────────────────────────────────────────────────────────
PMA_HOST=mysql-db
PMA_PORT=3306
PMA_ARBITRARY=0
UPLOAD_LIMIT=50M

# ── Debug Container ─────────────────────────────────────────────────────────
PMA_URL=http://phpmyadmin:80
