# === catch-all: ignore all dotfiles everywhere ===
# Explicit patterns below are redundant but kept for clarity.
.*
# === exceptions: dotfiles that SHOULD be tracked ===
!.github/
!.gitignore
!.gitmodules
!.env.example

# === byte-compiled / optimized / DLL files ===
__pycache__/
*.py[cod]
*.pyo
*.pyd

# === virtual environments ===
.venv/
env/
venv/

# === workspace ===
*.code-workspace

# === environment files ===
.env
.env.sample
.flaskenv
.env*.local

# === package manager / dependencies ===
node_modules/
package-lock.json
yarn.lock

# === Python build ===
*.egg-info/
dist/
build/

# === database & logs ===
*.db
*.sqlite3
*.log

# === debug task files ===
to_bg.json
from_bg.json
*.sql

# === tests and coverage ===
.pytest_cache/
.coverage
htmlcov/

# === AI agent / IDE ===
.claude/
.continue/
.vscode/
.idea/
*.swp
*.swo

# === OS ===
.DS_Store
Thumbs.db

# === personal notes ===
suggestions.md

# === Expo ===
.expo/
web-build/
expo-env.d.ts

# === Metro ===
.metro-health-check*

# === Native (Android / iOS) ===
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# === TypeScript ===
*.tsbuildinfo

# === MeterReadingApp-specific ===
MeterReadingApp/android/
MeterReadingApp/ios/

# === documentation-specific ===
documentation/site/

# === AI-generated docs (not part of project source) ===
docs/

# === Windows alternate data streams ===
*:Zone.Identifier
*:Zone.Identifier:*
Projects.code-workspace
Projects.code-workspace
