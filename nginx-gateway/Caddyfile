# Public port
:80 {
    handle /customer/* {
        reverse_proxy customer-portal:8002
    }
    handle /api/webhook/* {
        reverse_proxy api:8008
    }
    handle {
        reverse_proxy landing:8001
    }
}

# Private port — mTLS terminated by top-level nginx
:81 {
    handle /staff/* {
        reverse_proxy staff-portal:8003 {
            header_up X-SSL-Client-DN {http.request.header.X-SSL-Client-DN}
        }
    }
    handle /developer/* {
        reverse_proxy developer-portal:8004
    }
    handle /api/* {
        reverse_proxy api:8008
    }
}
